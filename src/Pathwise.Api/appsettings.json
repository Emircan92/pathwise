{
  "FrontendOrigin": "http://localhost:3000",
  "ConnectionStrings": {
    "Pathwise": "Data Source=data/pathwise.db"
  },
  "Riot": {
    "Player": { "GameName": "", "TagLine": "" },
    "Routing": { "Platform": "euw1", "Regional": "europe" },
    "RecentMatchCount": 50
  },
  "NarrativeInterpretation": {
    "Enabled": false,
    "Provider": "OpenAI",
    "Model": "gpt-5.6-sol",
    "ReasoningEffort": "medium",
    "TimeoutSeconds": 60,
    "MaximumOutputTokens": 6000,
    "BaseUrl": "https://api.openai.com/v1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
